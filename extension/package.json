{
  "name": "meridian-loom",
  "displayName": "Meridian Loom",
  "description": "A governed organisation of AI agents inside VS Code.",
  "version": "0.0.1",
  "publisher": "meridianloom",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:meridianLoom.agents",
    "onView:meridianLoom.stories",
    "onView:meridianLoom.loops",
    "onView:meridianLoom.skills",
    "onView:meridianLoom.ledger"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meridian-loom",
          "title": "Meridian Loom",
          "icon": "media/meridian.svg"
        }
      ]
    },
    "views": {
      "meridian-loom": [
        { "id": "meridianLoom.agents", "name": "Agents", "when": "meridian.tiers.orchestra" },
        { "id": "meridianLoom.stories", "name": "Stories", "when": "meridian.tiers.governor" },
        { "id": "meridianLoom.loops", "name": "Loops", "when": "meridian.tiers.orchestra" },
        { "id": "meridianLoom.skills", "name": "Skills", "when": "meridian.tiers.orchestra" },
        { "id": "meridianLoom.ledger", "name": "Ledger" }
      ]
    },
    "commands": [
      { "command": "meridian.ingestStory", "title": "Ingest Story", "category": "Meridian Loom" },
      { "command": "meridian.openRecorder", "title": "Open Recorder", "category": "Meridian Loom" },
      { "command": "meridian.installSkill", "title": "Install Skill", "category": "Meridian Loom" },
      { "command": "meridian.onboardAgent", "title": "Onboard Agent", "category": "Meridian Loom" },
      { "command": "meridian.exportAgent", "title": "Export Agent", "category": "Meridian Loom" },
      { "command": "meridian.importAgent", "title": "Import Agent", "category": "Meridian Loom" },
      { "command": "meridian.verifyChain", "title": "Verify Chain", "category": "Meridian Loom" },
      { "command": "meridian.haltAll", "title": "Halt All", "category": "Meridian Loom" },
      { "command": "meridian.steer", "title": "Steer", "category": "Meridian Loom" },
      { "command": "meridian.dryRun", "title": "Dry Run", "category": "Meridian Loom" },
      { "command": "meridian.abortStory", "title": "Abort Story", "category": "Meridian Loom" },
      { "command": "meridian.doctor", "title": "Doctor", "category": "Meridian Loom" },
      { "command": "meridian.installHook", "title": "Provenance Hook (Install / Remove)", "category": "Meridian Loom" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "meridian.ingestStory", "when": "meridian.tiers.orchestra" },
        { "command": "meridian.installSkill", "when": "meridian.tiers.orchestra" },
        { "command": "meridian.onboardAgent", "when": "meridian.tiers.orchestra" },
        { "command": "meridian.exportAgent", "when": "meridian.tiers.orchestra" },
        { "command": "meridian.importAgent", "when": "meridian.tiers.orchestra" },
        { "command": "meridian.haltAll", "when": "meridian.tiers.governor" },
        { "command": "meridian.steer", "when": "meridian.tiers.governor" },
        { "command": "meridian.dryRun", "when": "meridian.tiers.governor" },
        { "command": "meridian.abortStory", "when": "meridian.tiers.governor" }
      ]
    },
    "configuration": {
      "title": "Meridian Loom",
      "properties": {
        "meridian.python.interpreterPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter for the Meridian Core sidecar (>= 3.11). Empty resolves via the Python extension, then python3/python on PATH (FR-M3-05)."
        },
        "meridian.tiers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["flight-recorder", "governor", "orchestra"]
          },
          "default": ["flight-recorder"],
          "description": "Enabled product tiers (FR-M36-05). Flight Recorder is the base tier and is always on. Enabling Governor or Orchestra is a settings change only — no reinstall; disabling a tier leaves the tiers below fully functional (G5)."
        },
        "meridian.rejectionWindowDays": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 3650,
          "description": "FR-M37-01 (F0 Workstream F): a change rewritten by a later commit within this many days of its own commit date counts as rejected (reason replaced_within_window); removal after the window is evolution, not rejection. Reverts and force-amends are unconditional. Passed to trust/detectRejections as windowDays."
        },
        "meridian.greenfieldNewFileRatio": {
          "type": "number",
          "default": 0.5,
          "minimum": 0.01,
          "maximum": 1,
          "description": "FR-M37-06 (F0 Workstream F): a story/session is greenfield when its new-file ratio (files added / files added + modified) is at or above this threshold. Passed to trust/classify and trust/rejectionRate as newFileRatioThreshold."
        },
        "meridian.greenfieldMaxMedianAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 36500,
          "description": "FR-M37-06 (F0 Workstream F): a story/session is greenfield when the median age of the code it touched (per-line git history age) is below this many days. Passed to trust/classify and trust/rejectionRate as maxMedianAgeDays."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --sourcemap --outfile=dist/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run typecheck",
    "vscode:prepublish": "npm run build",
    "package": "node ../scripts/package-extension.mjs"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/vscode": "1.95.0",
    "@vscode/vsce": "3.2.2",
    "esbuild": "0.24.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
