    "TierSetParams": {
      "type": "object",
      "required": ["tiers"],
      "properties": {
        "tiers": {
          "type": "array",
          "items": { "$ref": "tiers.json#/$defs/TierName" }
        }
      },
      "additionalProperties": false
    }
  }
