    },
    "LoopStatusParams": {
      "type": "object",
      "required": ["loopId"],
      "properties": {
        "loopId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LoopStatusResult": {
      "type": "object",
      "required": ["loopId", "kind", "state", "iteration"],
      "properties": {
        "loopId": { "type": "string" },
        "kind": { "$ref": "#/$defs/LoopKind" },
        "state": { "$ref": "#/$defs/LoopState" },
        "iteration": { "type": "integer" },
        "lastCheckpoint": { "type": "string", "description": "Durable checkpoint id (FR-M4-05), present once the loop has checkpointed." }
      },
      "additionalProperties": false
    },
    "CancelParams": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "protocol.json#/$defs/RequestId" }
      },
      "additionalProperties": false
    },
    "GateEvaluateParams": {
      "type": "object",
      "required": ["storyId", "gate"],
      "properties": {
        "storyId": { "type": "string" },
        "gate": { "type": "string", "description": "Gate name, e.g. security, review (FR-M12-01)." }
      },
      "additionalProperties": false
    },
    "GateEvaluateResult": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["pass", "block"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "SteerSendParams": {
      "type": "object",
      "required": ["sessionId", "message"],
      "properties": {
        "sessionId": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SteerSendResult": {
      "type": "object",
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TrustSummaryParams": {
      "type": "object",
      "properties": {
        "agentId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TrustSummaryResult": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
