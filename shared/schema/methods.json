{
  "$id": "methods.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The initial message-bus method set the Simulation Core serves (FR-M32-01 foundation). Lifecycle methods (handshake, ping, shutdown, health) are implemented; ledger and loop methods are the contract the Simulation Core fills in during Workstreams D and E.",
  "x-methods": {
    "handshake": {
      "description": "First request after spawn. Carries the protocol version both ways; either side refuses on mismatch (FR-M3-08).",
      "params": { "$ref": "#/$defs/HandshakeParams" },
      "result": { "$ref": "#/$defs/HandshakeResult" }
    },
    "ping": {
      "description": "Heartbeat probe (FR-M3-06).",
      "params": { "$ref": "#/$defs/PingParams" },
      "result": { "$ref": "#/$defs/PingResult" }
    },
    "shutdown": {
      "description": "Polite teardown request; the sidecar exits after answering (FR-M3-02).",
      "params": { "$ref": "#/$defs/ShutdownParams" },
      "result": { "$ref": "#/$defs/ShutdownResult" }
    },
    "health": {
      "description": "Richer than ping: state, uptime, in-flight loop count.",
      "params": { "$ref": "#/$defs/HealthParams" },
      "result": { "$ref": "#/$defs/HealthResult" }
    },
    "doctor/run": {
      "description": "FR-M30-01: run the self-diagnostic check registry (interpreter, sidecar, keychain/signing key, ledger integrity, git hooks, observer health). Subsystems that are not built yet report a clear not-installed status with remediation instead of failing.",
      "params": { "$ref": "#/$defs/DoctorRunParams" },
      "result": { "$ref": "#/$defs/DoctorRunResult" }
    },
    "ledger.append": {
      "description": "Append an entry to the hash-chained ledger (FR-M10-01/02). Simulation Core writes entries marked simulated (FR-M32-02).",
      "params": { "$ref": "#/$defs/LedgerAppendParams" },
      "result": { "$ref": "#/$defs/LedgerAppendResult" }
    },
    "ledger.query": {
      "description": "Read back ledger entries (FR-M10-12).",
      "params": { "$ref": "#/$defs/LedgerQueryParams" },
      "result": { "$ref": "#/$defs/LedgerQueryResult" }
    },
    "loop.start": {
      "description": "Start one of the six canonical loops (FR-M4-03).",
      "params": { "$ref": "#/$defs/LoopStartParams" },
      "result": { "$ref": "#/$defs/LoopStatusResult" }
    },
    "loop.stop": {
      "description": "Stop a running loop; the loop checkpoints first (FR-M4-05).",
      "params": { "$ref": "#/$defs/LoopStopParams" },
      "result": { "$ref": "#/$defs/LoopStatusResult" }
    },
    "loop.status": {
      "description": "Current state of a loop instance.",
      "params": { "$ref": "#/$defs/LoopStatusParams" },
      "result": { "$ref": "#/$defs/LoopStatusResult" }
    },
    "gate.evaluate": {
      "description": "Governor tier stub (FR-M12-01; F1): evaluate a policy gate for a story. Registered now so tier enforcement is provable before F1 lands it; answers NOT_IMPLEMENTED while the governor tier is enabled, TIER_DISABLED while it is not.",
      "params": { "$ref": "#/$defs/GateEvaluateParams" },
      "result": { "$ref": "#/$defs/GateEvaluateResult" }
    },
    "steer.send": {
      "description": "Governor tier stub (FR-M25-01; F1): steer a running session. Same tier-enforcement role as gate.evaluate.",
      "params": { "$ref": "#/$defs/SteerSendParams" },
      "result": { "$ref": "#/$defs/SteerSendResult" }
    },
    "trust.summary": {
      "description": "Governor tier stub (FR-M37-*; F0 subset/F1 full): trust and rejection analytics summary. Same tier-enforcement role as gate.evaluate.",
      "params": { "$ref": "#/$defs/TrustSummaryParams" },
      "result": { "$ref": "#/$defs/TrustSummaryResult" }
    },
    "tiers/set": {
      "description": "FR-M36-05: notification carrying the enabled tier set after a meridian.tiers configuration change, so a tier flip needs no reinstall and no window reload. The base tier (flight-recorder) is always enabled regardless of payload.",
      "notification": true,
      "params": { "$ref": "#/$defs/TierSetParams" }
    },
    "$/cancel": {
      "description": "Notification cancelling an in-flight request by id (FR-M1-09).",
      "notification": true,
      "params": { "$ref": "#/$defs/CancelParams" }
    }
  },
  "$defs": {
    "HandshakeParams": {
      "type": "object",
      "required": ["protocolVersion", "client"],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "description": "Must equal PROTOCOL_VERSION or the sidecar refuses with PROTOCOL_MISMATCH."
        },
        "client": { "type": "string", "description": "e.g. meridian-loom-extension" },
        "tiers": {
          "type": "array",
          "items": { "$ref": "tiers.json#/$defs/TierName" },
          "description": "FR-M36-05: tiers enabled in this workspace (from the meridian.tiers setting). Absent means the sidecar default: flight-recorder only. The base tier is always enabled regardless."
        }
      },
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "required": ["methods", "framing"],
      "properties": {
        "methods": { "type": "array", "items": { "type": "string" } },
        "framing": { "const": "ndjson" }
      },
      "additionalProperties": false
    },
    "HandshakeResult": {
      "type": "object",
      "required": ["protocolVersion", "coreVersion", "pythonVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer" },
        "coreVersion": { "type": "string" },
        "pythonVersion": { "type": "string" },
        "capabilities": { "$ref": "#/$defs/Capabilities" }
      },
      "additionalProperties": false
    },
    "PingParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "PingResult": {
      "type": "object",
      "required": ["pong", "seq", "uptimeSeconds"],
      "properties": {
        "pong": { "const": true },
        "seq": { "type": "integer", "description": "Monotonic per-process ping counter." },
        "uptimeSeconds": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ShutdownParams": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ShutdownResult": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "const": true }
      },
      "additionalProperties": false
    },
    "HealthParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "HealthResult": {
      "type": "object",
      "required": ["status", "uptimeSeconds", "pid", "activeLoops"],
      "properties": {
        "status": { "enum": ["ok", "degraded", "shutting-down"] },
        "uptimeSeconds": { "type": "number" },
        "pid": { "type": "integer" },
        "activeLoops": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "DoctorCheckStatus": {
      "description": "Outcome of one doctor check. warn means usable but degraded or not yet installed; fail means broken and actionable.",
      "enum": ["pass", "warn", "fail"]
    },
    "DoctorCheck": {
      "type": "object",
      "required": ["id", "name", "status", "detail"],
      "properties": {
        "id": { "type": "string", "description": "Stable machine id, e.g. interpreter, sidecar, ledger." },
        "name": { "type": "string", "description": "Human-readable check name." },
        "status": { "$ref": "#/$defs/DoctorCheckStatus" },
        "detail": { "type": "string", "description": "What was found, in one line." },
        "remediation": { "type": "string", "description": "Actionable fix; always present on warn and fail." }
      },
      "additionalProperties": false
    },
    "DoctorRunParams": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Subset of check ids to run; absent runs the whole registry."
        },
        "workspaceDir": {
          "type": "string",
          "description": "Absolute path of the workspace folder; the git-hooks check needs it."
        }
      },
      "additionalProperties": false
    },
    "DoctorRunResult": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "$ref": "#/$defs/DoctorCheckStatus",
          "description": "Worst status across all checks: fail > warn > pass."
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/DoctorCheck" } }
      },
      "additionalProperties": false
    },
    "LedgerAppendParams": {
      "type": "object",
      "required": ["entryType", "payload"],
      "properties": {
        "entryType": { "type": "string" },
        "payload": { "type": "object" },
        "simulated": {
          "type": "boolean",
          "description": "Simulation Core marker (FR-M32-02); absent means false."
        }
      },
      "additionalProperties": false
    },
    "LedgerAppendResult": {
      "type": "object",
      "required": ["sequence", "hash"],
      "properties": {
        "sequence": { "type": "integer" },
        "hash": { "type": "string", "description": "Hash of this entry, chained from the previous (FR-M10-02)." }
      },
      "additionalProperties": false
    },
    "LedgerQueryParams": {
      "type": "object",
      "properties": {
        "entryType": { "type": "string" },
        "fromSequence": { "type": "integer" },
        "limit": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "LedgerEntry": {
      "type": "object",
      "required": ["sequence", "entryType", "hash", "previousHash", "timestamp", "simulated", "payload"],
      "properties": {
        "sequence": { "type": "integer" },
        "entryType": { "type": "string" },
        "hash": { "type": "string" },
        "previousHash": { "type": "string" },
        "timestamp": { "type": "string", "description": "ISO 8601 UTC." },
        "simulated": { "type": "boolean" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "LedgerQueryResult": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": { "type": "array", "items": { "$ref": "#/$defs/LedgerEntry" } }
      },
      "additionalProperties": false
    },
    "LoopKind": {
      "description": "The six canonical loops (FR-M4-03).",
      "enum": ["L1-micro", "L2-task", "L3-phase", "L4-delivery", "L5-learning", "L6-organisation"]
    },
    "LoopState": {
      "enum": ["pending", "running", "paused", "blocked", "completed", "failed", "aborted"]
    },
    "LoopStartParams": {
      "type": "object",
      "required": ["loopId", "storyId", "kind"],
      "properties": {
        "loopId": { "type": "string" },
        "storyId": { "type": "string" },
        "kind": { "$ref": "#/$defs/LoopKind" }
      },
      "additionalProperties": false
    },
    "LoopStopParams": {
      "type": "object",
      "required": ["loopId"],
      "properties": {
        "loopId": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LoopStatusParams": {
      "type": "object",
      "required": ["loopId"],
      "properties": {
        "loopId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LoopStatusResult": {
      "type": "object",
      "required": ["loopId", "kind", "state", "iteration"],
      "properties": {
        "loopId": { "type": "string" },
        "kind": { "$ref": "#/$defs/LoopKind" },
        "state": { "$ref": "#/$defs/LoopState" },
        "iteration": { "type": "integer" },
        "lastCheckpoint": { "type": "string", "description": "Durable checkpoint id (FR-M4-05), present once the loop has checkpointed." }
      },
      "additionalProperties": false
    },
    "CancelParams": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "protocol.json#/$defs/RequestId" }
      },
      "additionalProperties": false
    },
    "GateEvaluateParams": {
      "type": "object",
      "required": ["storyId", "gate"],
      "properties": {
        "storyId": { "type": "string" },
        "gate": { "type": "string", "description": "Gate name, e.g. security, review (FR-M12-01)." }
      },
      "additionalProperties": false
    },
    "GateEvaluateResult": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": { "enum": ["pass", "block"] },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "SteerSendParams": {
      "type": "object",
      "required": ["sessionId", "message"],
      "properties": {
        "sessionId": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": false
    },
    "SteerSendResult": {
      "type": "object",
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "TrustSummaryParams": {
      "type": "object",
      "properties": {
        "agentId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "TrustSummaryResult": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "TierSetParams": {
      "type": "object",
      "required": ["tiers"],
      "properties": {
        "tiers": {
          "type": "array",
          "items": { "$ref": "tiers.json#/$defs/TierName" }
        }
      },
      "additionalProperties": false
    }
  }
}
