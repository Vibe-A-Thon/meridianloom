{
  "$id": "methods.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The initial message-bus method set the Simulation Core serves (FR-M32-01 foundation). Lifecycle methods (handshake, ping, shutdown, health) are implemented; ledger and loop methods are the contract the Simulation Core fills in during Workstreams D and E.",
  "x-methods": {
    "handshake": {
      "description": "First request after spawn. Carries the protocol version both ways; either side refuses on mismatch (FR-M3-08).",
      "params": { "$ref": "#/$defs/HandshakeParams" },
      "result": { "$ref": "#/$defs/HandshakeResult" }
    },
    "ping": {
      "description": "Heartbeat probe (FR-M3-06).",
      "params": { "$ref": "#/$defs/PingParams" },
      "result": { "$ref": "#/$defs/PingResult" }
    },
    "shutdown": {
      "description": "Polite teardown request; the sidecar exits after answering (FR-M3-02).",
      "params": { "$ref": "#/$defs/ShutdownParams" },
      "result": { "$ref": "#/$defs/ShutdownResult" }
    },
    "health": {
      "description": "Richer than ping: state, uptime, in-flight loop count.",
      "params": { "$ref": "#/$defs/HealthParams" },
      "result": { "$ref": "#/$defs/HealthResult" }
    },
    "attrib/blame": {
      "description": "FR-M33-02 subset (F0 Workstream C): git-native line attribution. Every line of the given paths (or all tracked files) at ref (default HEAD) mapped to (commit, author name/email, timestamp, content). Blame never lands on merge commits; renames are followed. Zero model calls (FR-M36-07).",
      "params": { "$ref": "#/$defs/AttribBlameParams" },
      "result": { "$ref": "#/$defs/AttribBlameResult" }
    },
    "attrib/diff": {
      "description": "FR-M33-02 subset (F0 Workstream C): unified-diff attribution for the working tree (default), the index (staged), or a commit range (base..compare, added lines annotated with blame attribution at compare). Renames detected; untracked files reported as added. Working-tree added lines carry commit null — there is no commit yet.",
      "params": { "$ref": "#/$defs/AttribDiffParams" },
      "result": { "$ref": "#/$defs/AttribDiffResult" }
    },
    "attrib/symbol": {
      "description": "FR-M33-02 subset (F0 Workstream C task 14): tree-sitter line→symbol mapping — the qualified enclosing function/class of a line (e.g. \"PaymentController.submit\"). Unregistered languages degrade to symbol/language null, never a crash; only a missing file is an error. Zero model calls (FR-M36-07).",
      "params": { "$ref": "#/$defs/AttribSymbolParams" },
      "result": { "$ref": "#/$defs/AttribSymbolResult" }
    },
    "doctor/run": {
      "description": "FR-M30-01: run the self-diagnostic check registry (interpreter, sidecar, keychain/signing key, ledger integrity, git hooks, observer health). Subsystems that are not built yet report a clear not-installed status with remediation instead of failing.",
      "params": { "$ref": "#/$defs/DoctorRunParams" },
      "result": { "$ref": "#/$defs/DoctorRunResult" }
    },
    "ledger.append": {
      "description": "Append one entry to the hash-chained ledger (FR-M10-01/02). The RPC acknowledges only after the entry and chain update are durably committed (FR-M10-08). Inputs/outputs are SEC-07-redacted and stored encrypted in the blob store (FR-M10-07); the entry references their ciphertext digests. Simulation Core entries set simulated (FR-M32-02).",
      "params": { "$ref": "#/$defs/LedgerAppendParams" },
      "result": { "$ref": "#/$defs/LedgerAppendResult" }
    },
    "ledger.query": {
      "description": "Filterable entry stream (FR-M10-12, FR-M11-02): story, agent (actor), vendor, action type, sequence range, time range.",
      "params": { "$ref": "#/$defs/LedgerQueryParams" },
      "result": { "$ref": "#/$defs/LedgerQueryResult" }
    },
    "ledger.getEntry": {
      "description": "FR-M11-03 entry detail: full prompt/context and output (decrypted when the caller's sidecar holds the subject key), tool calls, confidence, cost, chain hashes.",
      "params": { "$ref": "#/$defs/LedgerGetEntryParams" },
      "result": { "$ref": "#/$defs/LedgerGetEntryResult" }
    },
    "ledger.verify": {
      "description": "FR-M11-01 chain integrity verdict: verified through sequence N, or a tamper indication naming the first divergent sequence (FR-M10-09).",
      "params": { "$ref": "#/$defs/LedgerVerifyParams" },
      "result": { "$ref": "#/$defs/LedgerVerifyResult" }
    },
    "ledger.proof": {
      "description": "FR-M11-04 proof inspection: an inclusion proof for one entry, or a consistency proof between two tree sizes (RFC 6962/9162 shapes).",
      "params": { "$ref": "#/$defs/LedgerProofParams" },
      "result": { "$ref": "#/$defs/LedgerProofResult" }
    },
    "ledger.exportBundle": {
      "description": "FR-M11-05 audit bundle for a range: signed tree head + chained entries (ciphertext refs + digests). Data assembly and signing land here; the full NIST SSDF AI-provenance / ISO 42001 mapping is F0-E task 25 (FR-M36-04).",
      "params": { "$ref": "#/$defs/LedgerExportBundleParams" },
      "result": { "$ref": "#/$defs/LedgerExportBundleResult" }
    },
    "loop.start": {
      "description": "Start one of the six canonical loops (FR-M4-03).",
      "params": { "$ref": "#/$defs/LoopStartParams" },
      "result": { "$ref": "#/$defs/LoopStatusResult" }
    },
    "loop.stop": {
      "description": "Stop a running loop; the loop checkpoints first (FR-M4-05).",
      "params": { "$ref": "#/$defs/LoopStopParams" },
      "result": { "$ref": "#/$defs/LoopStatusResult" }
    },
    "loop.status": {
      "description": "Current state of a loop instance.",
      "params": { "$ref": "#/$defs/LoopStatusParams" },
      "result": { "$ref": "#/$defs/LoopStatusResult" }
    },
    "gate.evaluate": {
      "description": "Governor tier stub (FR-M12-01; F1): evaluate a policy gate for a story. Registered now so tier enforcement is provable before F1 lands it; answers NOT_IMPLEMENTED while the governor tier is enabled, TIER_DISABLED while it is not.",
      "params": { "$ref": "#/$defs/GateEvaluateParams" },
      "result": { "$ref": "#/$defs/GateEvaluateResult" }
    },
    "steer.send": {
      "description": "Governor tier stub (FR-M25-01; F1): steer a running session. Same tier-enforcement role as gate.evaluate.",
      "params": { "$ref": "#/$defs/SteerSendParams" },
      "result": { "$ref": "#/$defs/SteerSendResult" }
    },
    "trust.summary": {
      "description": "Governor tier stub (FR-M37-*; F0 subset/F1 full): trust and rejection analytics summary. Same tier-enforcement role as gate.evaluate.",
      "params": { "$ref": "#/$defs/TrustSummaryParams" },
      "result": { "$ref": "#/$defs/TrustSummaryResult" }
    },
    "tiers/set": {
      "description": "FR-M36-05: notification carrying the enabled tier set after a meridian.tiers configuration change, so a tier flip needs no reinstall and no window reload. The base tier (flight-recorder) is always enabled regardless of payload.",
      "notification": true,
      "params": { "$ref": "#/$defs/TierSetParams" }
    },
    "$/cancel": {
      "description": "Notification cancelling an in-flight request by id (FR-M1-09).",
      "notification": true,
      "params": { "$ref": "#/$defs/CancelParams" }
    }
  },
  "$defs": {
    "HandshakeParams": {
      "type": "object",
      "required": ["protocolVersion", "client"],
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "description": "Must equal PROTOCOL_VERSION or the sidecar refuses with PROTOCOL_MISMATCH."
        },
        "client": { "type": "string", "description": "e.g. meridian-loom-extension" },
        "tiers": {
          "type": "array",
          "items": { "$ref": "tiers.json#/$defs/TierName" },
          "description": "FR-M36-05: tiers enabled in this workspace (from the meridian.tiers setting). Absent means the sidecar default: flight-recorder only. The base tier is always enabled regardless."
        },
        "workspaceDir": {
          "type": "string",
          "description": "Absolute workspace path. The ledger lives at <workspaceDir>/.meridian/ledger (FR-M10-01). Absent: ledger RPCs answer LEDGER_UNAVAILABLE until configured."
        },
        "ledgerSigningKey": {
          "type": "string",
          "description": "Base64-encoded 32-byte Ed25519 seed (FR-M10-04), sourced from the extension host's OS-keychain-backed SecretStorage (SEC-06) and provisioned over this handshake. Held in memory only; never persisted to disk or written into the ledger. Absent: the sidecar signs tree heads with an ephemeral key and doctor reports the missing keychain key."
        }
      },
      "additionalProperties": false
    },
    "Capabilities": {
      "type": "object",
      "required": ["methods", "framing"],
      "properties": {
        "methods": { "type": "array", "items": { "type": "string" } },
        "framing": { "const": "ndjson" }
      },
      "additionalProperties": false
    },
    "HandshakeResult": {
      "type": "object",
      "required": ["protocolVersion", "coreVersion", "pythonVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "integer" },
        "coreVersion": { "type": "string" },
        "pythonVersion": { "type": "string" },
        "capabilities": { "$ref": "#/$defs/Capabilities" }
      },
      "additionalProperties": false
    },
    "PingParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "PingResult": {
      "type": "object",
      "required": ["pong", "seq", "uptimeSeconds"],
      "properties": {
        "pong": { "const": true },
        "seq": { "type": "integer", "description": "Monotonic per-process ping counter." },
        "uptimeSeconds": { "type": "number" }
      },
      "additionalProperties": false
    },
    "ShutdownParams": {
      "type": "object",
      "properties": {
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ShutdownResult": {
      "type": "object",
      "required": ["ok"],
      "properties": {
        "ok": { "const": true }
      },
      "additionalProperties": false
    },
    "HealthParams": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "HealthResult": {
      "type": "object",
      "required": ["status", "uptimeSeconds", "pid", "activeLoops"],
      "properties": {
        "status": { "enum": ["ok", "degraded", "shutting-down"] },
        "uptimeSeconds": { "type": "number" },
        "pid": { "type": "integer" },
        "activeLoops": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "DoctorCheckStatus": {
      "description": "Outcome of one doctor check. warn means usable but degraded or not yet installed; fail means broken and actionable.",
      "enum": ["pass", "warn", "fail"]
    },
    "DoctorCheck": {
      "type": "object",
      "required": ["id", "name", "status", "detail"],
      "properties": {
        "id": { "type": "string", "description": "Stable machine id, e.g. interpreter, sidecar, ledger." },
        "name": { "type": "string", "description": "Human-readable check name." },
        "status": { "$ref": "#/$defs/DoctorCheckStatus" },
        "detail": { "type": "string", "description": "What was found, in one line." },
        "remediation": { "type": "string", "description": "Actionable fix; always present on warn and fail." }
      },
      "additionalProperties": false
    },
    "DoctorRunParams": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Subset of check ids to run; absent runs the whole registry."
        },
        "workspaceDir": {
          "type": "string",
          "description": "Absolute path of the workspace folder; the git-hooks check needs it."
        }
      },
      "additionalProperties": false
    },
    "DoctorRunResult": {
      "type": "object",
      "required": ["status", "checks"],
      "properties": {
        "status": {
          "$ref": "#/$defs/DoctorCheckStatus",
          "description": "Worst status across all checks: fail > warn > pass."
        },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/DoctorCheck" } }
      },
      "additionalProperties": false
    },
    "AttribBlameParams": {
      "type": "object",
      "required": ["repoPath"],
      "properties": {
        "repoPath": { "type": "string", "description": "Absolute path of the git repository (any directory inside it is accepted and resolved to the toplevel)." },
        "ref": { "type": "string", "description": "Commit-ish to blame; default HEAD." },
        "paths": { "type": "array", "items": { "type": "string" }, "description": "Worktree-relative file filter; absent blames every tracked file." }
      },
      "additionalProperties": false
    },
    "AttribBlameLine": {
      "type": "object",
      "required": ["path", "line", "commit", "authorName", "authorEmail", "authorTime", "content"],
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer", "description": "1-based line number in the ref's version of the file." },
        "commit": { "type": "string", "description": "Full hex sha of the introducing commit; never a merge commit." },
        "authorName": { "type": "string" },
        "authorEmail": { "type": "string" },
        "authorTime": { "type": "string", "description": "Author timestamp, ISO 8601 UTC." },
        "content": { "type": "string", "description": "Line content without the terminator (CRLF tolerated)." }
      },
      "additionalProperties": false
    },
    "AttribBlameResult": {
      "type": "object",
      "required": ["repoPath", "ref", "lines"],
      "properties": {
        "repoPath": { "type": "string", "description": "Resolved repository toplevel." },
        "ref": { "type": "string" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/AttribBlameLine" } }
      },
      "additionalProperties": false
    },
    "AttribDiffParams": {
      "type": "object",
      "required": ["repoPath"],
      "properties": {
        "repoPath": { "type": "string", "description": "Absolute path of the git repository (any directory inside it is accepted and resolved to the toplevel)." },
        "base": { "type": "string", "description": "Range start (commit-ish). With compare: base..compare; alone: base vs worktree." },
        "compare": { "type": "string", "description": "Range end (commit-ish); added lines are blame-annotated at this ref." },
        "staged": { "type": "boolean", "description": "Diff the index against HEAD (base optionally overrides HEAD)." },
        "paths": { "type": "array", "items": { "type": "string" }, "description": "Worktree-relative path filter." }
      },
      "additionalProperties": false
    },
    "AttribDiffLineKind": {
      "enum": ["added", "removed", "context"]
    },
    "AttribDiffLine": {
      "type": "object",
      "required": ["kind", "oldLine", "newLine", "content"],
      "properties": {
        "kind": { "$ref": "#/$defs/AttribDiffLineKind" },
        "oldLine": { "type": ["integer", "null"], "description": "1-based in the base version; null for pure additions." },
        "newLine": { "type": ["integer", "null"], "description": "1-based in the compare version; null for removals." },
        "content": { "type": "string" },
        "commit": { "type": ["string", "null"], "description": "Introducing commit for range-diff added lines (blame at compare); null for worktree/index changes." },
        "authorName": { "type": ["string", "null"] },
        "authorEmail": { "type": ["string", "null"] },
        "authorTime": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "AttribHunk": {
      "type": "object",
      "required": ["oldStart", "oldCount", "newStart", "newCount", "lines"],
      "properties": {
        "oldStart": { "type": "integer" },
        "oldCount": { "type": "integer" },
        "newStart": { "type": "integer" },
        "newCount": { "type": "integer" },
        "lines": { "type": "array", "items": { "$ref": "#/$defs/AttribDiffLine" } }
      },
      "additionalProperties": false
    },
    "AttribFileStatus": {
      "enum": ["added", "modified", "deleted", "renamed"]
    },
    "AttribFileDiff": {
      "type": "object",
      "required": ["path", "oldPath", "status", "hunks"],
      "properties": {
        "path": { "type": "string", "description": "Compare-side path." },
        "oldPath": { "type": ["string", "null"], "description": "Set for renames." },
        "status": { "$ref": "#/$defs/AttribFileStatus" },
        "hunks": { "type": "array", "items": { "$ref": "#/$defs/AttribHunk" } }
      },
      "additionalProperties": false
    },
    "AttribDiffResult": {
      "type": "object",
      "required": ["repoPath", "base", "compare", "staged", "files"],
      "properties": {
        "repoPath": { "type": "string", "description": "Resolved repository toplevel." },
        "base": { "type": ["string", "null"] },
        "compare": { "type": ["string", "null"] },
        "staged": { "type": "boolean" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/AttribFileDiff" } }
      },
      "additionalProperties": false
    },
    "AttribSymbolParams": {
      "type": "object",
      "required": ["repoPath", "path", "line"],
      "properties": {
        "repoPath": { "type": "string", "description": "Absolute path of the git repository (any directory inside it is accepted and resolved to the toplevel)." },
        "path": { "type": "string", "description": "Worktree-relative file path." },
        "line": { "type": "integer", "description": "1-based line number." }
      },
      "additionalProperties": false
    },
    "AttribSymbolResult": {
      "type": "object",
      "required": ["path", "line", "language", "symbol"],
      "properties": {
        "path": { "type": "string" },
        "line": { "type": "integer" },
        "language": { "type": ["string", "null"], "description": "Registered language id; null when the extension is not registered." },
        "symbol": { "type": ["string", "null"], "description": "Qualified enclosing definition, e.g. PaymentController.submit; null when none or degraded." }
      },
      "additionalProperties": false
    },
    "LedgerAppendParams": {
      "description": "One ledger entry, §7.2 columns in camelCase. input/output are redacted (SEC-07), encrypted and content-addressed (FR-M10-07); blob_subject selects the per-subject key (FR-M10-14).",
      "type": "object",
      "required": ["storyId", "phase", "loopId", "loopIteration", "actorId", "actorVersion", "actorKind", "policyVersion", "actionType"],
      "properties": {
        "storyId": { "type": "string" },
        "phase": { "type": "string" },
        "loopId": { "type": "string" },
        "loopIteration": { "type": "integer" },
        "actorId": { "type": "string" },
        "actorVersion": { "type": "string" },
        "actorKind": { "type": "string", "description": "orchestrator|role|stack|sub|xai|meta|external" },
        "policyVersion": { "type": "string" },
        "skillId": { "type": "string" },
        "skillVersion": { "type": "string" },
        "modelId": { "type": "string" },
        "modelVersion": { "type": "string" },
        "actionType": { "type": "string", "description": "plan|prompt|tool_call|diff|test_run|review|scan|gate|approval|policy_update|export" },
        "input": { "type": "string", "description": "Full prompt/context; redacted + encrypted into the blob store." },
        "output": { "type": "string", "description": "Resulting output; redacted + encrypted into the blob store." },
        "toolCalls": { "type": "array", "items": { "type": "object" } },
        "confidence": { "type": "number" },
        "decision": { "enum": ["proposed", "approved", "rejected", "reworked"] },
        "humanActor": { "type": "string" },
        "humanRole": { "type": "string" },
        "reworkReason": { "type": "string" },
        "tokensIn": { "type": "integer" },
        "tokensOut": { "type": "integer" },
        "costUsd": { "type": "number" },
        "latencyMs": { "type": "integer" },
        "worktreeRef": { "type": "string" },
        "repoId": { "type": "string" },
        "replayOf": { "type": "integer" },
        "vendor": { "type": "string", "description": "Default 'meridian'; external agents carry their vendor (FR-M35-03)." },
        "observationConfidence": { "enum": ["direct", "telemetry", "inferred"], "description": "FR-M35-02 observation confidence; default 'direct'." },
        "externalSessionId": { "type": "string" },
        "runId": { "type": "string" },
        "origin": { "enum": ["ui", "command", "omnibar", "chat", "editor", "file", "connector", "api"], "description": "FR-M40-02: written with the run's first entry." },
        "simulated": { "type": "boolean", "description": "FR-M32-02 simulation marker; absent means false." },
        "timestamp": { "type": "string", "description": "ISO 8601 UTC override (replay/golden corpus); absent = now." },
        "blobSubject": { "type": "string", "description": "Subject for the per-subject blob key; default 'default'." }
      },
      "additionalProperties": false
    },
    "LedgerAppendResult": {
      "type": "object",
      "required": ["sequence", "hash", "previousHash", "timestamp"],
      "properties": {
        "sequence": { "type": "integer" },
        "hash": { "type": "string", "description": "entry_hash hex, chained from the previous (FR-M10-02)." },
        "previousHash": { "type": "string" },
        "timestamp": { "type": "string" },
        "treeHead": { "$ref": "#/$defs/TreeHead", "description": "Present when this append emitted a signed tree head (FR-M10-04)." }
      },
      "additionalProperties": false
    },
    "TreeHead": {
      "description": "FR-M10-04 signed tree head: the Merkle root over entries 1..seq, Ed25519-signed; hex-encoded.",
      "type": "object",
      "required": ["seq", "rootHash", "signedAt", "signature"],
      "properties": {
        "seq": { "type": "integer" },
        "rootHash": { "type": "string" },
        "signedAt": { "type": "string" },
        "signature": { "type": "string" },
        "anchorRef": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LedgerQueryParams": {
      "type": "object",
      "properties": {
        "storyId": { "type": "string" },
        "actorId": { "type": "string", "description": "Agent id filter." },
        "vendor": { "type": "string" },
        "actionType": { "type": "string" },
        "fromSequence": { "type": "integer" },
        "toSequence": { "type": "integer" },
        "fromTimestamp": { "type": "string", "description": "ISO 8601 UTC lower bound (inclusive)." },
        "toTimestamp": { "type": "string", "description": "ISO 8601 UTC upper bound (inclusive)." },
        "limit": { "type": "integer", "description": "Default 100, clamped to 1000." }
      },
      "additionalProperties": false
    },
    "LedgerEntry": {
      "description": "FR-M11-02 stream shape: one ledger entry with chain hashes; blob payloads are referenced by digest/ref, not inlined.",
      "type": "object",
      "required": ["sequence", "timestamp", "storyId", "phase", "loopId", "loopIteration", "actorId", "actorVersion", "actorKind", "policyVersion", "actionType", "vendor", "observationConfidence", "simulated", "entryHash", "previousHash", "hasInputBlob", "hasOutputBlob"],
      "properties": {
        "sequence": { "type": "integer" },
        "timestamp": { "type": "string" },
        "storyId": { "type": "string" },
        "phase": { "type": "string" },
        "loopId": { "type": "string" },
        "loopIteration": { "type": "integer" },
        "actorId": { "type": "string" },
        "actorVersion": { "type": "string" },
        "actorKind": { "type": "string" },
        "policyVersion": { "type": "string" },
        "skillId": { "type": "string" },
        "skillVersion": { "type": "string" },
        "modelId": { "type": "string" },
        "modelVersion": { "type": "string" },
        "actionType": { "type": "string" },
        "toolCallsSummary": { "type": "integer", "description": "Count of tool calls; the array itself is in the entry detail (FR-M11-03)." },
        "confidence": { "type": "number" },
        "decision": { "type": "string" },
        "humanActor": { "type": "string" },
        "humanRole": { "type": "string" },
        "reworkReason": { "type": "string" },
        "tokensIn": { "type": "integer" },
        "tokensOut": { "type": "integer" },
        "costUsd": { "type": "number" },
        "latencyMs": { "type": "integer" },
        "worktreeRef": { "type": "string" },
        "repoId": { "type": "string" },
        "replayOf": { "type": "integer" },
        "vendor": { "type": "string" },
        "observationConfidence": { "type": "string" },
        "externalSessionId": { "type": "string" },
        "runId": { "type": "string" },
        "origin": { "type": "string" },
        "simulated": { "type": "boolean" },
        "entryHash": { "type": "string" },
        "previousHash": { "type": "string" },
        "hasInputBlob": { "type": "boolean" },
        "hasOutputBlob": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "LedgerQueryResult": {
      "type": "object",
      "required": ["entries"],
      "properties": {
        "entries": { "type": "array", "items": { "$ref": "#/$defs/LedgerEntry" } }
      },
      "additionalProperties": false
    },
    "LedgerGetEntryParams": {
      "type": "object",
      "required": ["sequence"],
      "properties": {
        "sequence": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "LedgerGetEntryResult": {
      "description": "FR-M11-03 detail. input/output carry the decrypted blob text when the sidecar holds the subject key; *Available flags say whether decryption succeeded (false when the key was crypto-shredded).",
      "type": "object",
      "required": ["sequence", "timestamp", "storyId", "phase", "loopId", "loopIteration", "actorId", "actorVersion", "actorKind", "policyVersion", "actionType", "vendor", "observationConfidence", "simulated", "entryHash", "previousHash", "inputAvailable", "outputAvailable"],
      "properties": {
        "sequence": { "type": "integer" },
        "timestamp": { "type": "string" },
        "storyId": { "type": "string" },
        "phase": { "type": "string" },
        "loopId": { "type": "string" },
        "loopIteration": { "type": "integer" },
        "actorId": { "type": "string" },
        "actorVersion": { "type": "string" },
        "actorKind": { "type": "string" },
        "policyVersion": { "type": "string" },
        "skillId": { "type": "string" },
        "skillVersion": { "type": "string" },
        "modelId": { "type": "string" },
        "modelVersion": { "type": "string" },
        "actionType": { "type": "string" },
        "toolCalls": { "type": "array", "items": { "type": "object" } },
        "confidence": { "type": "number" },
        "decision": { "type": "string" },
        "humanActor": { "type": "string" },
        "humanRole": { "type": "string" },
        "reworkReason": { "type": "string" },
        "tokensIn": { "type": "integer" },
        "tokensOut": { "type": "integer" },
        "costUsd": { "type": "number" },
        "latencyMs": { "type": "integer" },
        "worktreeRef": { "type": "string" },
        "repoId": { "type": "string" },
        "replayOf": { "type": "integer" },
        "vendor": { "type": "string" },
        "observationConfidence": { "type": "string" },
        "externalSessionId": { "type": "string" },
        "runId": { "type": "string" },
        "origin": { "type": "string" },
        "simulated": { "type": "boolean" },
        "entryHash": { "type": "string" },
        "previousHash": { "type": "string" },
        "inputDigest": { "type": "string" },
        "inputRef": { "type": "string" },
        "outputDigest": { "type": "string" },
        "outputRef": { "type": "string" },
        "blobKeyId": { "type": "string" },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "inputAvailable": { "type": "boolean" },
        "outputAvailable": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "LedgerVerifyParams": {
      "type": "object",
      "properties": {
        "upTo": { "type": "integer", "description": "Verify a prefix only; absent verifies the whole chain." }
      },
      "additionalProperties": false
    },
    "LedgerVerifyResult": {
      "description": "FR-M11-01 integrity banner payload.",
      "type": "object",
      "required": ["ok", "entriesChecked", "firstDivergentSequence", "detail", "verifiedAt"],
      "properties": {
        "ok": { "type": "boolean" },
        "entriesChecked": { "type": "integer" },
        "firstDivergentSequence": { "type": ["integer", "null"] },
        "detail": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LedgerInclusionProof": {
      "description": "RFC 6962 audit path for one leaf; hex-encoded hashes, leaf-upwards order (verifier: RFC 9162 §2.1.3.2).",
      "type": "object",
      "required": ["treeSize", "leafIndex", "leafHash", "rootHash", "path"],
      "properties": {
        "treeSize": { "type": "integer" },
        "leafIndex": { "type": "integer" },
        "leafHash": { "type": "string" },
        "rootHash": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "LedgerConsistencyProof": {
      "description": "RFC 6962/9162 consistency proof between two tree sizes; hex-encoded hashes (verifier: RFC 9162 §2.1.4.2).",
      "type": "object",
      "required": ["fromSize", "toSize", "fromRootHash", "toRootHash", "path"],
      "properties": {
        "fromSize": { "type": "integer" },
        "toSize": { "type": "integer" },
        "fromRootHash": { "type": "string" },
        "toRootHash": { "type": "string" },
        "path": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "LedgerProofParams": {
      "type": "object",
      "properties": {
        "sequence": { "type": "integer", "description": "Inclusion proof for this entry (1-based)." },
        "fromSize": { "type": "integer", "description": "Consistency proof: the earlier tree size." },
        "toSize": { "type": "integer", "description": "Consistency proof: the later tree size." }
      },
      "additionalProperties": false
    },
    "LedgerProofResult": {
      "type": "object",
      "properties": {
        "inclusion": { "$ref": "#/$defs/LedgerInclusionProof" },
        "consistency": { "$ref": "#/$defs/LedgerConsistencyProof" }
      },
      "additionalProperties": false
    },
    "LedgerExportBundleParams": {
      "type": "object",
      "properties": {
        "fromSequence": { "type": "integer", "description": "Default 1." },
        "toSequence": { "type": "integer", "description": "Default the ledger tip." },
        "storyId": { "type": "string", "description": "Optional filter within the range." },
        "agentId": { "type": "string", "description": "Optional filter within the range." }
      },
      "additionalProperties": false
    },
    "LedgerBundleEntry": {
      "description": "One entry in an audit bundle: the FR-M11-02 stream shape plus ciphertext refs and digests, so a third-party verifier can check the chain segment without any key.",
      "type": "object",
      "required": ["sequence", "timestamp", "storyId", "phase", "loopId", "actorId", "actorVersion", "actorKind", "actionType", "vendor", "observationConfidence", "simulated", "entryHash", "previousHash"],
      "properties": {
        "sequence": { "type": "integer" },
        "timestamp": { "type": "string" },
        "storyId": { "type": "string" },
        "phase": { "type": "string" },
        "loopId": { "type": "string" },
        "loopIteration": { "type": "integer" },
        "actorId": { "type": "string" },
        "actorVersion": { "type": "string" },
        "actorKind": { "type": "string" },
        "policyVersion": { "type": "string" },
        "skillId": { "type": "string" },
        "skillVersion": { "type": "string" },
        "modelId": { "type": "string" },
        "modelVersion": { "type": "string" },
        "actionType": { "type": "string" },
        "decision": { "type": "string" },
        "confidence": { "type": "number" },
        "humanActor": { "type": "string" },
        "humanRole": { "type": "string" },
        "reworkReason": { "type": "string" },
        "tokensIn": { "type": "integer" },
        "tokensOut": { "type": "integer" },
        "costUsd": { "type": "number" },
        "latencyMs": { "type": "integer" },
        "worktreeRef": { "type": "string" },
        "repoId": { "type": "string" },
        "replayOf": { "type": "integer" },
        "runId": { "type": "string" },
        "origin": { "type": "string" },
        "vendor": { "type": "string" },
        "observationConfidence": { "type": "string" },
        "externalSessionId": { "type": "string" },
        "simulated": { "type": "boolean" },
        "entryHash": { "type": "string" },
        "previousHash": { "type": "string" },
        "hasInputBlob": { "type": "boolean" },
        "hasOutputBlob": { "type": "boolean" },
        "inputDigest": { "type": "string" },
        "inputRef": { "type": "string" },
        "outputDigest": { "type": "string" },
        "outputRef": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LedgerBundleSigner": {
      "type": "object",
      "required": ["algorithm", "publicKey"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "publicKey": { "type": "string", "description": "Base64 raw public key; signature verification needs no trust in Meridian servers (SEC-29)." }
      },
      "additionalProperties": false
    },
    "LedgerRange": {
      "type": "object",
      "required": ["fromSequence", "toSequence"],
      "properties": {
        "fromSequence": { "type": "integer" },
        "toSequence": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "LedgerBundleFilter": {
      "type": "object",
      "properties": {
        "storyId": { "type": "string" },
        "agentId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "LedgerExportBundleResult": {
      "type": "object",
      "required": ["formatVersion", "generatedAt", "signer", "range", "filter", "entries"],
      "properties": {
        "formatVersion": { "type": "integer", "description": "Bundle format v1; the open ledger spec (FR-M36-06) will pin this." },
        "generatedAt": { "type": "string" },
        "signer": { "$ref": "#/$defs/LedgerBundleSigner" },
        "treeHead": { "$ref": "#/$defs/TreeHead", "description": "Signed head covering at least the range end; absent only when the ledger has no head yet (task 25 anchors this into the full SSDF bundle)." },
        "range": { "$ref": "#/$defs/LedgerRange" },
        "filter": { "$ref": "#/$defs/LedgerBundleFilter" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/LedgerBundleEntry" } }
      },
      "additionalProperties": false
    },
    "LoopKind": {
      "description": "The six canonical loops (FR-M4-03).",
      "enum": ["L1-micro", "L2-task", "L3-phase", "L4-delivery", "L5-learning", "L6-organisation"]
    },
    "LoopState": {
      "enum": ["pending", "running", "paused", "blocked", "completed", "failed", "aborted"]
    },
    "LoopStartParams": {
      "type": "object",
      "required": ["loopId", "storyId", "kind"],
      "properties": {
        "loopId": { "type": "string" },
        "storyId": { "type": "string" },
        "kind": { "$ref": "#/$defs/LoopKind" }
      },
      "additionalProperties": false
    },
    "LoopStopParams": {
      "type": "object",
      "required": ["loopId"],
      "properties": {
